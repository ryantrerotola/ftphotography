# Create a Sanity project at https://www.sanity.io/manage
# Then fill in these values:
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Resend (email service for contact form)
# Sign up at https://resend.com and get your API key
RESEND_API_KEY=re_your_api_key_here
# Once you verify a domain, replace with your domain's from address
RESEND_FROM_EMAIL=onboarding@resend.dev
# Where contact form submissions get delivered
CONTACT_EMAIL=hello@francescatrerotolaphotography.com
